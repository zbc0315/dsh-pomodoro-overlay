{
  "name": "@tom2012/dsh-pomodoro-overlay",
  "version": "0.1.1",
  "description": "Automatic focus/break Pomodoro cycles with a chat-sized translucent countdown for DeepSeek Harness Web.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbc0315/dsh-pomodoro-overlay.git"
  },
  "homepage": "https://github.com/zbc0315/dsh-pomodoro-overlay#readme",
  "bugs": {
    "url": "https://github.com/zbc0315/dsh-pomodoro-overlay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "lib",
    "client",
    "src",
    "tests",
    "tools",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node --check lib/index.js && node --check client/client.js && node tools/check-package.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run build && npm run check && npm test"
  },
  "dsh": {
    "category": "extension",
    "displayName": "番茄钟 Overlay",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pomodoro",
    "timer",
    "focus",
    "番茄钟"
  ]
}
